<!DOCTYPE html>
<html lang="ko">

<head>
  <%- include("../partials/head") %>
    <style>
      .card-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
        margin-top: 3rem;
      }

      .gallery-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--glass-border);
        transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        position: relative;
      }

      .gallery-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        border-color: rgba(0, 69, 140, 0.2);
      }

      .gallery-thumb-wrapper {
        height: 260px;
        background-color: #f8fafc;
        overflow: hidden;
        position: relative;
      }

      .gallery-thumb-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
      }

      .gallery-card:hover .gallery-thumb-wrapper img {
        transform: scale(1.06);
      }

      .image-count-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(0, 0, 0, 0.65);
        color: white;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.8rem;
        backdrop-filter: blur(8px);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 5px;
        z-index: 2;
      }

      .gallery-content {
        padding: 1.5rem 1.8rem;
        display: flex;
        flex-direction: column;
        flex: 1;
        justify-content: space-between;
        background: white;
      }

      .gallery-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--color-text);
        letter-spacing: -0.02em;
        line-height: 1.4;
        margin-bottom: 0.6rem;
        transition: color 0.2s ease;
        word-break: keep-all;
      }

      .gallery-card:hover .gallery-title {
        color: var(--color-primary);
      }

      .gallery-date {
        color: #64748b;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 500;
      }

      .gallery-admin-footer {
        font-size: 0.85rem;
        border-top: 1px solid #f1f5f9;
        padding-top: 0.9rem;
        margin-top: 1rem;
        display: flex;
        gap: 15px;
      }

      .gallery-admin-footer a {
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s;
      }

      @media (max-width: 1100px) {
        .card-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 2rem;
        }
      }

      @media (max-width: 650px) {
        .card-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .gallery-thumb-wrapper {
          height: 230px;
        }

        .gallery-content {
          padding: 1.25rem 1.4rem;
        }

        .gallery-title {
          font-size: 1.1rem;
        }
      }
    </style>
</head>

<body>
  <%- include("../partials/header") %>
    <section class="page-header" data-aos="fade">
      <div class="container">
        <h1 data-aos="fade-up" data-aos-delay="100">교회 앨범</h1>
        <ul class="breadcrumb" data-aos="fade-up" data-aos-delay="300">
          <li><a href="/">홈</a></li>
          <li>나눔</li>
          <li class="active">교회 앨범</li>
        </ul>
      </div>
    </section>

    <div class="container" style="padding-bottom: var(--spacing-xl);">
      <% if (locals.user && user.isAdmin) { %>
        <div style="text-align: right; margin-bottom: 1rem;">
          <a href="#" onclick="openAdminModal('/admin/write/galleryItems', '앨범 등록')" class="btn btn-primary">앨범 등록</a>
        </div>
      <% } %>

      <div class="card-grid">
        <% if (locals.galleryItems && galleryItems.length > 0) { %>
          <% galleryItems.forEach(function(item) { 
            const images = Array.isArray(item.images) ? item.images :
              (item.images ? [item.images] : (item.image ? [item.image] : [])); 
          %>
            <a href="/sharing/gallery/<%= item.id %>" class="gallery-card" data-aos="fade-up">
              <div class="gallery-thumb-wrapper">
                <% if (images.length > 0) { %>
                  <img src="<%= images[0] %>" alt="<%= item.title %>" loading="lazy">
                  <% if (images.length > 1) { %>
                    <div class="image-count-badge">
                      <i class="fas fa-images"></i> <%= images.length %>장
                    </div>
                  <% } %>
                <% } else { %>
                  <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #cbd5e1;">
                    <i class="fas fa-image" style="font-size: 3.5rem;"></i>
                  </div>
                <% } %>
              </div>
              <div class="gallery-content">
                <div>
                  <h3 class="gallery-title">
                    <%= item.title %>
                  </h3>
                  <p class="gallery-date">
                    <i class="far fa-calendar-alt"></i>
                    <%= item.date %>
                  </p>
                </div>
                <% if (locals.user && user.isAdmin) { %>
                  <div class="gallery-admin-footer" onclick="event.preventDefault(); event.stopPropagation();">
                    <a href="#" onclick="openAdminModal('/admin/edit/galleryItems/<%= item.id %>', '앨범 수정')"
                      style="color: var(--color-secondary);"><i class="fas fa-edit"></i> 수정</a>
                    <a href="/admin/delete/galleryItems/<%= item.id %>" onclick="return confirm('정말 삭제하시겠습니까?')"
                      style="color: #ef4444;"><i class="fas fa-trash-alt"></i> 삭제</a>
                  </div>
                <% } %>
              </div>
            </a>
          <% }); %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 10rem 0; color: #94a3b8; background: white; border-radius: 30px; border: 1px dashed #cbd5e1;">
            <i class="far fa-images" style="font-size: 4rem; margin-bottom: 2rem; display: block; opacity: 0.3;"></i>
            <p style="font-size: 1.2rem;">등록된 사진이 없습니다.</p>
          </div>
        <% } %>
      </div>

      <% if (locals.totalPages > 1) { %>
        <div class="premium-pagination" style="margin-top: 5rem;">
          <% if (currentPage > 1) { %>
            <a href="/sharing/gallery?page=<%= currentPage - 1 %>" class="nav-btn">
              <i class="fas fa-chevron-left"></i>
            </a>
          <% } %>

          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="active">
                <%= i %>
              </span>
            <% } else { %>
              <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                <a href="/sharing/gallery?page=<%= i %>">
                  <%= i %>
                </a>
              <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                <span style="border:none; box-shadow:none; background:none; min-width:20px;">...</span>
              <% } %>
            <% } %>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a href="/sharing/gallery?page=<%= currentPage + 1 %>" class="nav-btn">
              <i class="fas fa-chevron-right"></i>
            </a>
          <% } %>
        </div>
      <% } %>

      <!-- Related Action -->
      <div class="related-info-section" data-aos="fade-up" style="margin-top: 6rem;">
        <h4 style="margin-bottom: 2rem; color: var(--color-text-light); font-weight: 700;">다른 나눔 안내 보기</h4>
        <div class="sharing-info-links">
          <a href="/sharing/notices" class="btn btn-outline">공지 사항</a>
          <a href="/sharing/bulletin" class="btn btn-outline">주보 안내</a>
        </div>
      </div>
    </div>

    <%- include("../partials/footer") %>
      <script src="/js/main.js"></script>
</body>

</html>
